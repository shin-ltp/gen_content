{
  "segment": "S24-B4-01",
  "slide": "s24",
  "voice": "xiaomei",
  "total_pieces": 14,
  "silence_config": {
    "pause_long": 1.0,
    "pause_short": 0.45,
    "period": 0.35
  },
  "pieces": [
    {
      "text": "エヌビディアのもう一つの対極で、同様に根強い悲観論が崩れました。",
      "after": "period",
      "index": 0,
      "wav": "seg_0000.wav"
    },
    {
      "text": "セールスフォースです。",
      "after": "period",
      "index": 1,
      "wav": "seg_0001.wav"
    },
    {
      "text": "木曜の株価は二十二パーセント高。",
      "after": "period",
      "index": 2,
      "wav": "seg_0002.wav"
    },
    {
      "text": "二千二十年八月の二十六パーセント高に次ぐ、史上二番目の上昇幅です。",
      "after": "period",
      "index": 3,
      "wav": "seg_0003.wav"
    },
    {
      "text": "年初来ではマイナス二十二パーセントと大きく出遅れ、二千二十五年末の終値からは一時四十三パーセントも下落していた銘柄が、一夜で大部分を取り戻しました。",
      "after": "period",
      "index": 4,
      "wav": "seg_0004.wav"
    },
    {
      "text": "この急騰は単独ではなく、ソフトイーティーエフが約五パーセント上昇し、アドビ、サービスナウ、パランティア、フィグマなどSaaS群が一斉に買われました。",
      "after": "period",
      "index": 5,
      "wav": "seg_0005.wav"
    },
    {
      "text": "決算そのものは上々です。",
      "after": "period",
      "index": 6,
      "wav": "seg_0006.wav"
    },
    {
      "text": "売上高は百十三点五億ドルと前年比十一パーセント増、コンセンサスの百十三点二億ドルを上回りました。",
      "after": "period",
      "index": 7,
      "wav": "seg_0007.wav"
    },
    {
      "text": "調整後イーピーエスは五点九ドルと、予想三点二七ドルを大きく超える数字です。",
      "after": "period",
      "index": 8,
      "wav": "seg_0008.wav"
    },
    {
      "text": "ただしこのイーピーエスには、アンソロピックへの出資による約二十六億ドルの戦略的投資益が含まれています。",
      "after": "period",
      "index": 9,
      "wav": "seg_0009.wav"
    },
    {
      "text": "アンソロピックの企業価値は今や九千六百五十億ドル。",
      "after": "period",
      "index": 10,
      "wav": "seg_0010.wav"
    },
    {
      "text": "アルファベットやマイクロソフトも同社出資の評価益を計上しており、「エーアイラボの持有」それ自体が決算を左右する時代になっています。",
      "after": "period",
      "index": 11,
      "wav": "seg_0011.wav"
    },
    {
      "text": "フリーキャッシュフローは八十一パーセント増の十一億ドル。",
      "after": "period",
      "index": 12,
      "wav": "seg_0012.wav"
    },
    {
      "text": "来季以降も通期売上の指引を四百六十一〜四百六十四億ドルへ引き上げました。",
      "after": null,
      "index": 13,
      "wav": "seg_0013.wav"
    }
  ]
}