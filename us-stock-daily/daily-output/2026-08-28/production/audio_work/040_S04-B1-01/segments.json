  "silence_config": {
    "pause_long": 1.0,
    "pause_short": 0.45,
    "period": 0.35
  },
  "pieces": [
    {
      "text": "昨日の米国市場は、エヌビディアの一言で動きました。",
      "after": "period",
      "index": 0,
      "wav": "seg_0000.wav"
    },
    {
      "text": "水曜の引け後に発表されたFY二千二十七第二四半期（五〜七月期）は、売上高九百六十二点二億ドルと前年同期比百六パーセント増。",
      "after": "period",
      "index": 1,
      "wav": "seg_0001.wav"
    },
    {
      "text": "LSEGコンセンサスの九百二十一点六五億ドルを大きく上回りました。",
      "after": "period",
      "index": 2,
      "wav": "seg_0002.wav"
    },
    {
      "text": "調整後イーピーエスは二点四六ドルと前年比百二十八パーセント増、こちらも予想二点一ドルを大きく上回る圧勝です。",
      "after": "period",
      "index": 3,
      "wav": "seg_0003.wav"
    },
    {
      "text": "データセンター部門は売上八百九十点二億ドル・前年比百十七パーセント増。",
      "after": "period",
      "index": 4,
      "wav": "seg_0004.wav"
    },
    {
      "text": "うちハイパースケーラー向けが四百八十七億ドルと倍増し、エーアイクラウド・産業・企業向けのACIEセグメントも四百三億ドル・百三十八パーセント増と、両輪が揃った形です。",
      "after": "period",
      "index": 5,
      "wav": "seg_0005.wav"
    },
    {
      "text": "注目は株価の反応です。",
      "after": "period",
      "index": 6,
      "wav": "seg_0006.wav"
    },
    {
      "text": "発表直後は一旦わずかに下落しましたが、決算説明会が始まると急転直下プラスに転じ、翌日の木曜は八点七四パーセント高の二百二十七点九八ドルで終えました。",
      "after": "period",
      "index": 7,
      "wav": "seg_0007.wav"
    },
    {
      "text": "二千二十四年五月以来となる大きな上昇です。",
      "after": "period",
      "index": 8,
      "wav": "seg_0008.wav"
    },
    {
      "text": "時価総額は五点四九兆ドルに達し、単日での増加額四千四百十五億ドルは、上場企業史上二番目の規模です。",
      "after": "period",
      "index": 9,
      "wav": "seg_0009.wav"
    },
    {
      "text": "過去四四半期、エヌビディアは決算後に下げることを繰り返してきたジンクスを、今回は打ち破りました。",
      "after": null,
      "index": 10,
      "wav": "seg_0010.wav"
    }
  ]
}