{
  "segment": "S11-B2-03",
  "slide": "s11",
  "voice": "xiaomei",
  "total_pieces": 13,
  "silence_config": {
    "pause_long": 1.0,
    "pause_short": 0.45,
    "period": 0.35
  },
  "pieces": [
    {
      "text": "一方で、Stratecheryのベン・トンプソン氏の構造分析は聞く価値があります。",
      "after": "period",
      "index": 0,
      "wav": "seg_0000.wav"
    },
    {
      "text": "彼の問題意識は「お金の時系列」です。",
      "after": "period",
      "index": 1,
      "wav": "seg_0001.wav"
    },
    {
      "text": "エーアイ企業は自由キャッシュフローから始め、約一年で社債市場を使い果たし、いまグーグルは増資に踏み切った。",
      "after": "period",
      "index": 2,
      "wav": "seg_0002.wav"
    },
    {
      "text": "次の金はどこから来るのか。",
      "after": "period",
      "index": 3,
      "wav": "seg_0003.wav"
    },
    {
      "text": "エヌビディアについて彼は、より鋭い点を突きます。",
      "after": "period",
      "index": 4,
      "wav": "seg_0004.wav"
    },
    {
      "text": "二十五パーセントの融資バックストップと引き換えに、新興クラウド企業から二千三十年までの購入約束を得る構図は、リスクの引き受けであり、実質的な値引きだ、と。",
      "after": "period",
      "index": 5,
      "wav": "seg_0005.wav"
    },
    {
      "text": "報告利益率には現れないが、割引キャッシュフロー分析には確実に現れる、という指摘です。",
      "after": "period",
      "index": 6,
      "wav": "seg_0006.wav"
    },
    {
      "text": "そして長期の競争相手はエーエムディーではなく、資本コストの低いグーグルとアマゾンだ、と断じます。",
      "after": "period",
      "index": 7,
      "wav": "seg_0007.wav"
    },
    {
      "text": "グーグルはティーピーユーの約二割をすでにアンソロピックに販売しており、アマゾンもトレイニウムの外販へ動いている。",
      "after": "period",
      "index": 8,
      "wav": "seg_0008.wav"
    },
    {
      "text": "彼はこの現状を十九世紀の鉄道泡沫になぞらえます。",
      "after": "period",
      "index": 9,
      "wav": "seg_0009.wav"
    },
    {
      "text": "鉄道は期限のズレで世界の資金を使い果たし、泡沫は弾けた。",
      "after": "period",
      "index": 10,
      "wav": "seg_0010.wav"
    },
    {
      "text": "それでも鉄道は残り、その後百年、経済を支え続けた。",
      "after": "period",
      "index": 11,
      "wav": "seg_0011.wav"
    },
    {
      "text": "今回の泡沫が弾けても、電力インフラという遺産は残る、と。",
      "after": null,
      "index": 12,
      "wav": "seg_0012.wav"
    }
  ]
}