# === 音声生成 TTS バックエンド ===
# fish（既定・Fish Audio S2 Pro INT8）| qwen | voxcpm（バックアップ切替）
TTS_BACKEND=fish

# === Fish Audio S2 Pro INT8（TTS_BACKEND=fish 時・Mac MLX / SSH）===
# FISH_AUDIO_TTS_REMOTE_HOST=cho@rw-mac-1
# FISH_AUDIO_TTS_REMOTE_VENV=/Users/cho/fish-audio/.venv
# FISH_AUDIO_TTS_REMOTE_WORKROOT=/Users/cho/fish-audio/jobs
# FISH_AUDIO_TTS_REMOTE_WORKER=/Users/cho/fish-audio/scripts/fish_audio_mlx_worker.py
# FISH_AUDIO_TTS_CHECKPOINT=   # 空=worker 側デフォルト
# FISH_AUDIO_TTS_MAX_SEQ_LEN=4096
# FISH_AUDIO_TTS_CHUNK_LENGTH=300
# 参考音角色（assests/refs/{role}/ref_audio.wav — Fish / Qwen / VoxCPM 共通）
# TTS_REF_ROLE=kyoujyu

# === Qwen3-TTS（TTS_BACKEND=qwen 時・バックアップ）===
# QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# QWEN_TTS_BATCH_SIZE=6
# QWEN_TTS_DTYPE=float32
# QWEN_TTS_LANGUAGE=Japanese
# QWEN_TTS_REMOTE_HOST=cho@llm-spot
# QWEN_TTS_REMOTE_ZONE=us-central1-b
# QWEN_TTS_REMOTE_PROJECT=fuzoku-sns
# QWEN_TTS_SSH_DETACHED_WORKER=1

# Google Gemini API Key（テキスト生成・画像生成用）
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini モデル（テキスト生成: Pro / 軽量改写: Flash）
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_FLASH_MODEL=gemini-3.1-flash-lite-preview

# === 記事分析（analyze_content.py）の最適化 ===
# 分析ステップ専用プロバイダ（既定: gemini）
# ANALYSIS_TXT_GENERATION_PROVIDER=gemini
# 1リクエストあたりの記事数（大きいほど呼び出し回数が減り RPM 制限に強くなる）
# ANALYSIS_BATCH_SIZE=20
# API 呼び出し間隔（秒・RPM 制限対策）
# ANALYSIS_API_MIN_INTERVAL_SEC=30
# 失敗時の自動リトライ（429/5xx や一時的エラー対策）
# ANALYSIS_MAX_RETRIES=3
# リトライ1回目の待機時間（秒）・以降は指数バックオフで 60→120→240 秒
# ANALYSIS_RETRY_BASE_WAIT_SEC=60

# Google Cloud Platform (Storage 等)
GCP_PROJECT_ID=your_project_id
GCP_BUCKET_NAME=your_gcs_bucket_name
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json


# Remotion
REMOTION_LICENSE=LICENSE_KEY_IF_NEEDED

# === 画像生成プロバイダ ===
# gemini | alibaba（DashScope 百炼・文生图）| comfyui（ComfyUI 自托管 GPU）
IMG_GENERATION_PROVIDER=comfyui

# === 参考画像による img2img 生成（無効化済み・既定オフ）===
# IMAGE_REFERENCE_ENABLED=0
# COMFYUI_IMG2IMG_DENOISE=0.55
# IMAGE_REFERENCE_SEARCH_LIMIT=5
# IMAGE_REFERENCE_DOWNLOAD_TIMEOUT=30
# IMAGE_REFERENCE_MIN_BYTES=20480
# IMAGE_REFERENCE_SEARXNG_URL=http://localhost:8888
# IMAGE_REFERENCE_SEARXNG_ENGINES=bing images,duckduckgo images,google images
# IMAGE_REFERENCE_SEARXNG_TIMEOUT=20
# IMAGE_REFERENCE_SEARCH_BACKENDS=searxng,wikimedia
# IMAGE_REFERENCE_BING_API_KEY=

# === ComfyUI 自托管（IMG_GENERATION_PROVIDER=comfyui）===
# COMFYUI_REMOTE_HOST=cho@rw-mac-1
# ※ ~/.ssh/config の HostName が *.local (mDNS) の場合、解決失敗で poll が停滞しやすい。
#   安定させるには HostName を LAN IP に変更する（例: HostName 192.168.x.x）。
# COMFYUI_DIR=/Users/cho/comfyui/ComfyUI
# COMFYUI_OUTPUT_DIR=/Users/cho/comfyui/ComfyUI/output
# COMFYUI_VAE_NAME=ae.safetensors
# 1 ジョブの最大待機（秒）。FLUX t2i は通常 1〜3 分（既定 600）
# COMFYUI_GENERATION_TIMEOUT=600
# SSH 経由 curl の最大待機（秒）。ComfyUI 処理中の API 遅延対策（既定 15）
# COMFYUI_CURL_MAX_TIME=15

# === Gemini 画像生成（IMG_GENERATION_PROVIDER=gemini）===
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# === 阿里云百炼（IMG_GENERATION_PROVIDER=alibaba）===
# ALIBABA_API_KEY=your_alibaba_api_key
# ALIBABA_API_URL=https://dashscope-intl.aliyuncs.com/api/v1
# ALIBABA_IMAGE_MODEL=wan2.7-image-pro
