  },
  "pieces": [
    {
      "text": "これを「循環融資のカードハウス」と呼ぶ向きがありますが、強気側の論拠も具体的です。",
      "after": "period",
      "index": 0,
      "wav": "seg_0000.wav"
    },
    {
      "text": "キャンターのアナリストは「これは循環ではなく促進だ。",
      "after": "period",
      "index": 1,
      "wav": "seg_0001.wav"
    },
    {
      "text": "エーアイ投資サイクルが長く続くという明確なシグナル」と評価します。",
      "after": "period",
      "index": 2,
      "wav": "seg_0002.wav"
    },
    {
      "text": "需要の数字も実在します。",
      "after": "period",
      "index": 3,
      "wav": "seg_0003.wav"
    },
    {
      "text": "アンソロピックの年換算収益は七月に六百五十億ドルへ達し、前年比七倍。",
      "after": "period",
      "index": 4,
      "wav": "seg_0004.wav"
    },
    {
      "text": "四半期の暫定収益も百十五億ドルで十四倍です。",
      "after": "period",
      "index": 5,
      "wav": "seg_0005.wav"
    },
    {
      "text": "オープンエーアイも四百億ドルに到達しています。",
      "after": "period",
      "index": 6,
      "wav": "seg_0006.wav"
    },
    {
      "text": "コアウィーブは売上前年比百十二パーセント増、受注残は千四十億ドル。",
      "after": "period",
      "index": 7,
      "wav": "seg_0007.wav"
    },
    {
      "text": "シーイーオーは「ブラックウェルとベラ・ルービンの価格とマージンが過去最高を更新している」と証言します。",
      "after": null,
      "index": 8,
      "wav": "seg_0008.wav"
    }
  ]
}