{
  "segment": "S21-B3-03",
  "slide": "s21",
  "voice": "xiaomei",
  "total_pieces": 15,
  "silence_config": {
    "pause_long": 1.0,
    "pause_short": 0.45,
    "period": 0.35
  },
  "pieces": [
    {
      "text": "一方、データの側は待ったなしです。",
      "after": "period",
      "index": 0,
      "wav": "seg_0000.wav"
    },
    {
      "text": "水曜に発表された七月のPCEデフレーターは、総合で前月比零点二パーセント、前年比三点七パーセントと零点一ポイントコンセンサスを上回りました。",
      "after": "period",
      "index": 1,
      "wav": "seg_0001.wav"
    },
    {
      "text": "エフアールビーが重視するコアは前月比零点二パーセント、前年比三点三パーセントと予想通り。",
      "after": "period",
      "index": 2,
      "wav": "seg_0002.wav"
    },
    {
      "text": "個人所得は零点四パーセント増、支出は零点二パーセント増とこちらも堅調です。",
      "after": "period",
      "index": 3,
      "wav": "seg_0003.wav"
    },
    {
      "text": "財価格はエネルギーが二点七パーセント下落してマイナス零点一パーセント。",
      "after": "period",
      "index": 4,
      "wav": "seg_0004.wav"
    },
    {
      "text": "サービスは零点三パーセント上昇し、うち金融サービスが一点二パーセント、住宅が零点三パーセント上がりました。",
      "after": "period",
      "index": 5,
      "wav": "seg_0005.wav"
    },
    {
      "text": "二パーセントの目標にはほど遠い。",
      "after": "period",
      "index": 6,
      "wav": "seg_0006.wav"
    },
    {
      "text": "しかも利上げの理由は明確に存在します。",
      "after": "period",
      "index": 7,
      "wav": "seg_0007.wav"
    },
    {
      "text": "クリーブランド連銀のハマック総裁は木曜、CNBCの生インタビューで「先入観を持つつもりはないが、今が行動の時だと信じる」と語りました。",
      "after": "period",
      "index": 8,
      "wav": "seg_0008.wav"
    },
    {
      "text": "「インフレ情勢は五年以上続いている。",
      "after": "period",
      "index": 9,
      "wav": "seg_0009.wav"
    },
    {
      "text": "金融環境を見ても、市場の関係者に話を聞いても、政策に制約は見られない」。",
      "after": "period",
      "index": 10,
      "wav": "seg_0010.wav"
    },
    {
      "text": "彼女は七月のエフオーエムシーで三票の反対の一人であり、零点二五ポイントの利上げを主張しました。",
      "after": "period",
      "index": 11,
      "wav": "seg_0011.wav"
    },
    {
      "text": "エリーの労働者たちの話を引きつつ「良い仕事に就き、毎日働いても、週末に子どもとアイスクリームを買う余裕がないという絶望感がある」と述べたのは印象的です。",
      "after": "period",
      "index": 12,
      "wav": "seg_0012.wav"
    },
    {
      "text": "ただし市場の織り込みは冷静で、九月と十月は据え置き、次の利上げは十二月と見ています。",
      "after": "period",
      "index": 13,
      "wav": "seg_0013.wav"
    },
    {
      "text": "九月会合での動きの確率は三分の一程度です。",
      "after": null,
      "index": 14,
      "wav": "seg_0014.wav"
    }
  ]
}