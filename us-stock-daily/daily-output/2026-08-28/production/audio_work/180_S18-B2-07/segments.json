{
  "segment": "S18-B2-07",
  "slide": "s18",
  "voice": "xiaomei",
  "total_pieces": 18,
  "silence_config": {
    "pause_long": 1.0,
    "pause_short": 0.45,
    "period": 0.35
  },
  "pieces": [
    {
      "text": "ジェフリーズのザーボス氏は「十年債は過去二十年で最も狭いレンジにあり、暴走などしていない。",
      "after": "period",
      "index": 0,
      "wav": "seg_0000.wav"
    },
    {
      "text": "ベッセントは戦術的な財務長官という新しいタイプだ」と擁護します。",
      "after": "period",
      "index": 1,
      "wav": "seg_0001.wav"
    },
    {
      "text": "ベッセント長官自身も「今年の予算赤字はおそらくピークアウトした。",
      "after": "period",
      "index": 2,
      "wav": "seg_0002.wav"
    },
    {
      "text": "関税収入は返還不要の形で戻ってくる。",
      "after": "period",
      "index": 3,
      "wav": "seg_0003.wav"
    },
    {
      "text": "四十兆ドルという数字に魔法はない。",
      "after": "period",
      "index": 4,
      "wav": "seg_0004.wav"
    },
    {
      "text": "成長で乗り越えられる」と反論しています。",
      "after": "period",
      "index": 5,
      "wav": "seg_0005.wav"
    },
    {
      "text": "モルガン・スタンレーも、政府債務は増えても民間部門のバランスシートは健全で、家計債務の対GDP比は六十七パーセントと二千十九年を六ポイント下回ると指摘。",
      "after": "period",
      "index": 6,
      "wav": "seg_0006.wav"
    },
    {
      "text": "三十年債の実質利回りが期待インフレを約三ポイント上回る水準で、ようやく債券が株に競合し始める段階だと分析しています。",
      "after": "period",
      "index": 7,
      "wav": "seg_0007.wav"
    },
    {
      "text": "この問題の本質は、金利の水準そのものより「市場の価格発見機能をどこまで政府が代替できるか」にあります。",
      "after": "period",
      "index": 8,
      "wav": "seg_0008.wav"
    },
    {
      "text": "私見では、ドラケンミラー氏の「ファンダメンタルズには逆らえない」という原則は長期で正しい。",
      "after": "period",
      "index": 9,
      "wav": "seg_0009.wav"
    },
    {
      "text": "ただし短期では、九千五百億ドルのTGAと十一月の借り入れ発表までは、財務省にもカードが残っています。",
      "after": "period",
      "index": 10,
      "wav": "seg_0010.wav"
    },
    {
      "text": "個人投資家にとって重要なのは、自分で三十年債を買うかどうかではなく、この長期金利の攻防が株式の割引率を決めるという点です。",
      "after": "period",
      "index": 11,
      "wav": "seg_0011.wav"
    },
    {
      "text": "行動指針として三つ。",
      "after": "period",
      "index": 12,
      "wav": "seg_0012.wav"
    },
    {
      "text": "第一に、九月九日の初回オペの規模と、その後のブレークイーブン・レートの反応を確認すること。",
      "after": "period",
      "index": 13,
      "wav": "seg_0013.wav"
    },
    {
      "text": "第二に、十一月四日の四半期借り入れ発表で長期債発行比率が実際に下がるかを見ること。",
      "after": "period",
      "index": 14,
      "wav": "seg_0014.wav"
    },
    {
      "text": "これがシトリニの言う「新協定」の最初の証明になります。",
      "after": "period",
      "index": 15,
      "wav": "seg_0015.wav"
    },
    {
      "text": "第三に、ポートフォリオでは長期金利の上昇リスクをヘッジする意味でも、期間の短い債券と現金を一定比率で保持すること。",
      "after": "period",
      "index": 16,
      "wav": "seg_0016.wav"
    },
    {
      "text": "利回りだけを見て三十年債に飛びつくのは、政府と同じ賭けを個人でやることに近いです。",
      "after": null,
      "index": 17,
      "wav": "seg_0017.wav"
    }
  ]
}