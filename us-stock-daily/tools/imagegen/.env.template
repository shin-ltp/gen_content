# === us-stock-daily 文生图环境变量 ===
# 将本文件内容复制为 ../../.env（或本项目根 us-stock-daily/.env），填入实际密钥。
# .env 已被 gitignore，不会提交。

# === 默认文生图 provider ===
# qwen（DashScope qwen-image-3.0-pro・默认）| comfyui（Mac FLUX2）
IMG_GENERATION_PROVIDER=qwen

# 默认 provider 失败时是否自动回退到另一个 provider（1/0）
IMG_GENERATION_FALLBACK=1

# === qwen-image-3.0-pro（DashScope 百炼・文生图）===
# DashScope 的 API Key（必填，主 provider 使用）
QWEN_IMAGE_API_KEY=your_dashscope_api_key
# DashScope base URL（图像接口会自动拼 /services/aigc/multimodal-generation/generation）
#  Token Plan（sk-sp- 开头 key）: https://token-plan.ap-southeast-1.maas.aliyuncs.com/api/v1
#  ※ 文生图不支持 compatible-mode；Token Plan 走同步（不加 X-DashScope-Async）
QWEN_IMAGE_API_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/api/v1
# 图像模型（默认 qwen-image-3.0-pro）
QWEN_IMAGE_MODEL=qwen-image-3.0-pro
# 输出尺寸（宽*高，竖版 768*1024）
QWEN_IMAGE_SIZE=768*1024
# 单次生成最长等待秒数（同步）
QWEN_IMAGE_GENERATION_TIMEOUT=300
# 是否加水印（0=否，1=是）
QWEN_IMAGE_WATERMARK=0

# === ComfyUI（IMG_GENERATION_PROVIDER=comfyui 时・Mac FLUX2 备用）===
# Mac 机 SSH 目标（user@host，需可免密 SSH 登录）
COMFYUI_REMOTE_HOST=you@your-mac
# Mac 上 ComfyUI 目录
COMFYUI_DIR=/Users/you/comfyui/ComfyUI
COMFYUI_VENV=/Users/you/comfyui/.venv
# ComfyUI 输出目录（用于 SCP 取回图片）
COMFYUI_OUTPUT_DIR=/Users/you/comfyui/ComfyUI/output
COMFYUI_VAE_NAME=ae.safetensors
COMFYUI_API_PORT=8188
# 输出尺寸与步数（Mac MPS）
COMFYUI_IMAGE_WIDTH=768
COMFYUI_IMAGE_HEIGHT=1024
COMFYUI_STEPS=4
# 单任务最长等待秒数
COMFYUI_GENERATION_TIMEOUT=600
COMFYUI_SSH_CONNECT_TIMEOUT=30
COMFYUI_SSH_RETRY_COUNT=3
