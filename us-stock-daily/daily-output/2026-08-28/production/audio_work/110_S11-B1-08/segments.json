{
  "segment": "S11-B1-08",
  "slide": "s11",
  "voice": "xiaomei",
  "total_pieces": 20,
  "silence_config": {
    "pause_long": 1.0,
    "pause_short": 0.45,
    "period": 0.35
  },
  "pieces": [
    {
      "text": "この決算の本質は、数字そのものより「見える化の前倒し」です。",
      "after": "period",
      "index": 0,
      "wav": "seg_0000.wav"
    },
    {
      "text": "一年先の指引を出せるのは、サプライチェーン全体の発注状況を握っているからです。",
      "after": "period",
      "index": 1,
      "wav": "seg_0001.wav"
    },
    {
      "text": "ベルンスタインの言う通り、資産規模五千三百億ドル級のバランスシート自体が参入障壁になっている。",
      "after": "period",
      "index": 2,
      "wav": "seg_0002.wav"
    },
    {
      "text": "もはやエヌビディアの護城河はチップの性能だけでなく、資本調達力と供給網の支配にあると言えます。",
      "after": "period",
      "index": 3,
      "wav": "seg_0003.wav"
    },
    {
      "text": "シナリオで整理すると次のようになります。",
      "after": "period",
      "index": 4,
      "wav": "seg_0004.wav"
    },
    {
      "text": "好シナリオは、メモリ価格がFY二千二十八に落ち着き、粗利率七十二〜七十三パーセントの指引を上回るケース。",
      "after": "period",
      "index": 5,
      "wav": "seg_0005.wav"
    },
    {
      "text": "この場合、FY二千二十九の一兆ドル収入論が現実味を帯び、株価の上昇は続きます。",
      "after": "period",
      "index": 6,
      "wav": "seg_0006.wav"
    },
    {
      "text": "基準シナリオは、メモリ高が続く分、粗利率は指引どおり低めに推移し、代わりに収入が上振れでカバーするケース。",
      "after": "period",
      "index": 7,
      "wav": "seg_0007.wav"
    },
    {
      "text": "数字の上では成長は続きますが、利益の質を巡る議論が市場を揺さぶり続けます。",
      "after": "period",
      "index": 8,
      "wav": "seg_0008.wav"
    },
    {
      "text": "悪シナリオは、ハイパースケーラーのカスタムチップへの移行が想定より速く、ACIEセグメントの伸びが鈍るケース。",
      "after": "period",
      "index": 9,
      "wav": "seg_0009.wav"
    },
    {
      "text": "ただしこのシナリオは、AWSの二百万基追加発注という事実が当面は否定しています。",
      "after": "period",
      "index": 10,
      "wav": "seg_0010.wav"
    },
    {
      "text": "留意すべきは、指引には中国向けデータセンター収入がゼロで織り込まれている点で、これは追加の上振れ余地でもあります。",
      "after": "period",
      "index": 11,
      "wav": "seg_0011.wav"
    },
    {
      "text": "個人の行動指針として三つ。",
      "after": "period",
      "index": 12,
      "wav": "seg_0012.wav"
    },
    {
      "text": "第一に、八点七四パーセント高の翌日に追撃しないこと。",
      "after": "period",
      "index": 13,
      "wav": "seg_0013.wav"
    },
    {
      "text": "インベスティング・クラブは二百八十ドルへの目標株価引き上げを示していますが、急騰直後の買いはリスクが高い。",
      "after": "period",
      "index": 14,
      "wav": "seg_0014.wav"
    },
    {
      "text": "第二に、粗利率の推移を注視すること。",
      "after": "period",
      "index": 15,
      "wav": "seg_0015.wav"
    },
    {
      "text": "メモリ価格がFY二千二十八まで高いままである限り、利益の質に関する議論は続きます。",
      "after": "period",
      "index": 16,
      "wav": "seg_0016.wav"
    },
    {
      "text": "マイクロンなどメモリ側の決算が、エヌビディアの粗利率の先行指標になります。",
      "after": "period",
      "index": 17,
      "wav": "seg_0017.wav"
    },
    {
      "text": "第三に、カスタムチップへのシフトは徐々に進むという前提で、ポートフォリオのエーアイ関連比率を過度に一極化させないこと。",
      "after": "period",
      "index": 18,
      "wav": "seg_0018.wav"
    },
    {
      "text": "需要が実在するからこそ、供給側の分散が効いてくる局面です。",
      "after": null,
      "index": 19,
      "wav": "seg_0019.wav"
    }
  ]
}